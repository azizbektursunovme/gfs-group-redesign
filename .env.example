# Where the contact form sends its JSON (agree on it with the backend developer, https only).
# Today the live site uses a GoHighLevel form; its fields map 1:1 to this form (see README).
# Empty = preview mode: nothing is sent anywhere.
PUBLIC_CONTACT_ENDPOINT=

# Canonical/og:url origin. Defaults to https://gfs-groupllc.com.
PUBLIC_CANONICAL_ORIGIN=

# "true" adds <meta name="robots" content="noindex"> (used for the GitHub Pages preview).
PUBLIC_NOINDEX=
