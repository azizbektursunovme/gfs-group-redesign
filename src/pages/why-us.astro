---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, links, stats, reasons, benefits, survey } from '../data/site';
import { reviews, reviewCount } from '../data/reviews';
import { url } from '../lib/url';

const driverReviews = reviews.filter((r) => r.group !== 'partners').slice(0, 3);
---
<Base
  title={`Why drivers choose GFS Group | ${company.legalName}`}
  description="Weekly direct deposit, steady freight lanes, home time that works and 24/7 support. See why CDL drivers and owner-operators drive with GFS Group."
  current="why"
>
  <PageHero
    title="Why drivers choose GFS"
    lead="It is not just about moving freight. It is about careers, relationships and trust on every road."
    photo="path-drivers"
    crumbs={[{ label: 'Why Us' }]}
  >
    <div class="btn-row">
      <a class="btn btn--lg" href={links.apply} target="_blank" rel="noopener">Apply on Tenstreet <Icon name="external" /></a>
      <a class="btn btn--line btn--lg" href={url('services/')}>Our services</a>
    </div>
  </PageHero>

  <section class="section section--tight" aria-label="GFS Group in numbers">
    <div class="wrap">
      <ul class="stats">
        {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.note}</small></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="diff-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="diff-title">What makes us different</h2>
        <p>Four promises we make to every driver who joins.</p>
      </div>
      <ul class="features features--2">
        {reasons.map((r) => <li class="feature"><span class="icon-box"><Icon name={r.icon} /></span><h3>{r.title}</h3><p>{r.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="benefits-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="benefits-title">Everything you need to thrive on the road</h2>
        <p>Not just a job: a career built on real support, real pay and respect for your time and your family.</p>
      </div>
      <ul class="features features--3">
        {benefits.map((b) => <li class="feature"><span class="icon-box"><Icon name={b.icon} /></span><h3>{b.title}</h3><p>{b.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="survey-title">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="survey-title">How drivers rate us</h2>
        <p class="muted">Results from our internal driver survey, by area.</p>
        <p class="hint">{survey.source}.</p>
      </div>
      <ul class="bars">
        {survey.items.map((s) => (
          <li class="bar">
            <span>{s.label}</span><strong>{s.pct}%</strong>
            <span class="bar__track" aria-hidden="true"><span style={`width:${s.pct}%`}></span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="voices-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <h2 id="voices-title">Hear it from our drivers</h2>
        </div>
        <a class="text-link" href={url('reviews/')}>Read all {reviewCount} reviews <Icon name="chevron" /></a>
      </div>
      <ul class="reviews">
        {driverReviews.map((r) => <ReviewCard review={r} />)}
      </ul>
    </div>
  </section>

  <CtaBand title="Ready to drive with the best?" text="Join our growing family of professional drivers and partners. Your success is our mission." />
</Base>
