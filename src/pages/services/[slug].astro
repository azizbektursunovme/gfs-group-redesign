---
// /services/trucking-services and /services/logistics-solutions. The live pages printed raw "<p>" tags;
// here the text is plain data.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { company, services } from '../../data/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props as { service: (typeof services)[number] };
const other = services.find((s) => s.slug !== service.slug)!;
---
<Base title={`${service.title} | ${company.legalName}`} description={`${service.lead} ${service.included.join(', ')}.`} current="services">
  <PageHero title={service.title} lead={service.lead} crumbs={[{ label: 'Services', href: 'services/' }, { label: service.title }]} />

  <section class="section">
    <div class="wrap split">
      <div class="split__copy">
        <h2>What's included</h2>
        <p class="muted">{service.body}</p>
        <ul class="checks">{service.included.map((i) => <li>{i}</li>)}</ul>
        <div class="btn-row">
          <a class="btn" href="#contact-form">Get a tailored quote</a>
          <a class="btn btn--line" href={company.phoneHref}><Icon name="phone" />{company.phone}</a>
        </div>
        <a class="text-link" href={url(`services/${other.slug}/`)}>Also see {other.title.toLowerCase()} <Icon name="chevron" /></a>
      </div>
      <Photo name={service.photo} alt="" widths={[480, 800]} sizes="(min-width: 900px) 560px, 100vw" />
    </div>
  </section>

  <section class="section section--grey" aria-label="Contact">
    <ContactBlock heading="Ready to get moving?" text="Speak with a GFS specialist and get a tailored quote for your operation." />
  </section>
</Base>
